datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  runner
  admin
}

enum RunnerStatus {
  pending
  approved
  rejected
}

enum VehicleType {
  bike
  car
  foot
}

enum BookingStatus {
  pending
  accepted
  shopping
  delivered
  cancelled
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(customer)
  createdAt    DateTime  @default(now())

  customerBookings Booking[]       @relation("customer")
  runnerProfile    Runner?
  credentials      WebAuthnCredential[]
}

// One passkey (platform authenticator, security key or phone) per row.
model WebAuthnCredential {
  id           String   @id
  userId       String
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String[]
  deviceName   String   @default("Passkey")
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Runner {
  userId      String   @id
  areas       String[]
  status      RunnerStatus @default(pending)
  vehicleType VehicleType?
  // Vetting details: idNumber is only ever shown to admins; the plate is shown
  // to a customer once this runner has accepted their booking.
  idNumber    String?
  plateNumber String?
  active      Boolean  @default(false)
  rating      Float    @default(0)
  activeSince DateTime?
  createdAt   DateTime @default(now())
  approvedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("runner")
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String
  runnerId     String?
  area         String
  notes        String
  budgetKes    Int
  slotStart    DateTime
  slotEnd      DateTime
  status       BookingStatus @default(pending)
  // Set when a booking is offered to a specific runner; that offer is released
  // back to the open queue when respondBy passes or the runner declines.
  respondBy    DateTime?
  acceptedAt   DateTime?
  items        BookingItem[]
  payment      Payment?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer User   @relation("customer", fields: [customerId], references: [id], onDelete: Cascade)
  runner   Runner? @relation("runner", fields: [runnerId], references: [userId])

  @@index([status, slotStart])
  @@index([runnerId, slotStart])
  @@index([customerId, createdAt])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  name      String
  quantity  Int     @default(1)
  maxPriceKes Int?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  amountKes     Int
  status        PaymentStatus @default(pending)
  checkoutId    String?
  mpesaReceipt  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
