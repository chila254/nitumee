# Postgres connection string (Neon in production, local PGlite in development)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Comma-separated emails that become admins on sign-up or sign-in.
# Admins approve runner applications and see the operations dashboard.
ADMIN_EMAILS="you@example.com"

# Public URL of the deployed site, used for Open Graph/Twitter image URLs.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://nitumee.com"
